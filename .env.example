# Banco de dados (Postgres — ex: Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/afrodreads?sslmode=require"

# Mercado Pago (Conta Negócio)
# Access Token de PRODUÇÃO fica só no ambiente do Vercel, nunca commitado.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="troque-por-um-segredo-forte"

# URL pública do site (usada nos back_urls do checkout e no webhook)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
