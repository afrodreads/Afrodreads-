# Banco de dados (Postgres — ex: Vercel Postgres / Neon / Supabase)
# Em produção (Vercel Postgres via Neon):
#   DATABASE_URL = valor de POSTGRES_PRISMA_URL (conexão pooled, usada pela aplicação)
#   DIRECT_URL   = valor de POSTGRES_URL_NON_POOLING (conexão direta, usada só pelas migrations)
# Em desenvolvimento local, as duas podem apontar para o mesmo Postgres local.
DATABASE_URL="postgresql://user:password@host:5432/afrodreads?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/afrodreads?sslmode=require"

# Mercado Pago (Conta Negócio)
# Access Token de PRODUÇÃO fica só no ambiente do Vercel, nunca commitado.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="troque-por-um-segredo-forte"

# URL pública do site (usada nos back_urls do checkout e no webhook)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Painel administrativo (/admin)
ADMIN_PASSWORD="troque-por-uma-senha-forte"
ADMIN_SESSION_SECRET="troque-por-um-segredo-aleatorio-longo"

# E-mail transacional (Resend) — usado para a confirmação automática de
# agendamento após o pagamento do sinal ser aprovado.
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Afro Dreads <contato@afrodreads.com.br>"
